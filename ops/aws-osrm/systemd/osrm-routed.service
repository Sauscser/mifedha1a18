[Unit]
Description=OSRM Routed Container
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/osrm
RemainAfterExit=true
ExecStart=/usr/bin/docker compose up -d osrm-routed
ExecStop=/usr/bin/docker compose stop osrm-routed
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
